>0</w><w>,</w><w>2</w><w>,</w><w>0</w></wrow><wb>)</wb></wrow></w></wsup><wrow><w></w><wb>[</wb><wrow><w></w><w>x</w><w>,</w><w>y</w><w>,</w><w>z</w></wrow><wb>]</wb></wrow></wrow><w>+</w><wrow><w></w><wsup><w></w><w>A1</w><w><wrow><w></w><wb>(</wb><wrow><w></w><w>1</w><w>,</w><w>0</w><w>,</w><w>1</w></wrow><wb>)</wb></wrow></w></wsup><wrow><w></w><wb>[</wb><wrow><w></w><w>x</w><w>,</w><w>y</w><w>,</w><w>z</w></wrow><wb>]</wb></wrow></wrow><w>-</w><wrow><w></w><wsup><w></w><w>A3</w><w><wrow><w></w><wb>(</wb><wrow><w></w><w>2</w><w>,</w><w>0</w><w>,</w><w>0</w></wrow><wb>)</wb></wrow></w></wsup><wrow><w></w><wb>[</wb><wrow><w></w><w>x</w><w>,</w><w>y</w><w>,</w><w>z</w></wrow><wb>]</wb></wrow></wrow></wrow><wb>)</wb></wrow></wrow></w><w><w></w><w><wrow><w></w><w>4</w><w></w><w>π</w></wrow></w></w></wfrac></wrow></w><w><w></w><w><w>c</w></w></w></wfrac></wrow><wb>}</wb></wrow></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "{(((-1/2*I)*hbar*q^3*A1[x, y, z]*ψ[x, y, z]*ψc[x, y, z]*(ψc[x, y, z]*Derivative[1, 0, 0][ψ][x, y, z] - ψ[x, y, z]*Derivative[1, 0, 0][ψc][x, y, z]))/(c*m^2) + (c*(-Derivative[0, 0, 2][A1][x, y, z] - Derivative[0, 2, 0][A1][x, y, z] + Derivative[1, 0, 1][A3][x, y, z] + Derivative[1, 1, 0][A2][x, y, z]))/(4*Pi))/c, (((-1/2*I)*hbar*q^3*A2[x, y, z]*ψ[x, y, z]*ψc[x, y, z]*(ψc[x, y, z]*Derivative[0, 1, 0][ψ][x, y, z] - ψ[x, y, z]*Derivative[0, 1, 0][ψc][x, y, z]))/(c*m^2) + (c*(-Derivative[0, 0, 2][A2][x, y, z] + Derivative[0, 1, 1][A3][x, y, z] + Derivative[1, 1, 0][A1][x, y, z] - Derivative[2, 0, 0][A2][x, y, z]))/(4*Pi))/c, (((-1/2*I)*hbar*q^3*A3[x, y, z]*ψ[x, y, z]*ψc[x, y, z]*(ψc[x, y, z]*Derivative[0, 0, 1][ψ][x, y, z] - ψ[x, y, z]*Derivative[0, 0, 1][ψc][x, y, z]))/(c*m^2) + (c*(Derivative[0, 1, 1][A2][x, y, z] - Derivative[0, 2, 0][A3][x, y, z] + Derivative[1, 0, 1][A1][x, y, z] - Derivative[2, 0, 0][A3][x, y, z]))/(4*Pi))/c}",
       "mime": "text/plain"
      }
     ],
     "id": "47be53b9-10d8-49fb-aebb-ab24a64dca31",
     "metadata": {
