      {
       "data": "α*ψ[x, y, z]*ψc[x, y, z] + (q^2*A1[x, y, z]^2*ψ[x, y, z]*ψc[x, y, z])/(2*c^2*m) + (q^2*A2[x, y, z]^2*ψ[x, y, z]*ψc[x, y, z])/(2*c^2*m) + (q^2*A3[x, y, z]^2*ψ[x, y, z]*ψc[x, y, z])/(2*c^2*m) + (β*ψ[x, y, z]^2*ψc[x, y, z]^2)/2 + ((I/2)*hbar*q*A3[x, y, z]*ψc[x, y, z]*Derivative[0, 0, 1][ψ][x, y, z])/(c*m) - ((I/2)*hbar*q*A3[x, y, z]*ψ[x, y, z]*Derivative[0, 0, 1][ψc][x, y, z])/(c*m) + (hbar^2*Derivative[0, 0, 1][ψ][x, y, z]*Derivative[0, 0, 1][ψc][x, y, z])/(2*m) + ((I/2)*hbar*q*A2[x, y, z]*ψc[x, y, z]*Derivative[0, 1, 0][ψ][x, y, z])/(c*m) - ((I/2)*hbar*q*A2[x, y, z]*ψ[x, y, z]*Derivative[0, 1, 0][ψc][x, y, z])/(c*m) + (hbar^2*Derivative[0, 1, 0][ψ][x, y, z]*Derivative[0, 1, 0][ψc][x, y, z])/(2*m) + ((I/2)*hbar*q*A1[x, y, z]*ψc[x, y, z]*Derivative[1, 0, 0][ψ][x, y, z])/(c*m) - ((I/2)*hbar*q*A1[x, y, z]*ψ[x, y, z]*Derivative[1, 0, 0][ψc][x, y, z])/(c*m) + (hbar^2*Derivative[1, 0, 0][ψ][x, y, z]*Derivative[1, 0, 0][ψc][x, y, z])/(2*m)",
       "mime": "text/plain"
      }
