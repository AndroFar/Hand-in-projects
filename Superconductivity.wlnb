></w><w>ψc</w><w><wrow><w></w><wb>(</wb><wrow><w></w><w>1</w><w>,</w><w>0</w><w>,</w><w>0</w></wrow><wb>)</wb></wrow></w></wsup><wrow><w></w><wb>[</wb><wrow><w></w><w>x</w><w>,</w><w>y</w><w>,</w><w>z</w></wrow><wb>]</wb></wrow></wrow></wrow></w><w><w></w><w><wrow><w></w><w>2</w><w></w><w>c</w><w></w><w>m</w></wrow></w></w></wfrac><w>+</w><wfrac><w><wrow><w></w><wsup><w></w><w>hbar</w><w><w>2</w></w></wsup><w></w><wrow><w></w><wsup><w></w><w>ψ</w><w><wrow><w></w><wb>(</wb><wrow><w></w><w>1</w><w>,</w><w>0</w><w>,</w><w>0</w></wrow><wb>)</wb></wrow></w></wsup><wrow><w></w><wb>[</wb><wrow><w></w><w>x</w><w>,</w><w>y</w><w>,</w><w>z</w></wrow><wb>]</wb></wrow></wrow><w></w><wrow><w></w><wsup><w></w><w>ψc</w><w><wrow><w></w><wb>(</wb><wrow><w></w><w>1</w><w>,</w><w>0</w><w>,</w><w>0</w></wrow><wb>)</wb></wrow></w></wsup><wrow><w></w><wb>[</wb><wrow><w></w><w>x</w><w>,</w><w>y</w><w>,</w><w>z</w></wrow><wb>]</wb></wrow></wrow></wrow></w><w><w></w><w><wrow><w></w><w>2</w><w></w><w>m</w></wrow></w></w></wfrac></wrow></div>",
