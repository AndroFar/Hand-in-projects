[1, 0.75, 0], RGBColor[0.647624, 0.37816, 0.614037], RGBColor[0.571589, 0.586483, 0.], RGBColor[0.915, 0.3325, 0.2125], RGBColor[0.40082222609352647, 0.5220066643438841, 0.85], RGBColor[0.9728288904374106, 0.621644452187053, 0.07336199581899142], RGBColor[0.736782672705901, 0.358, 0.5030266573755369], RGBColor[0.28026441037696703, 0.715, 0.4292089322474965]}, \"DefaultBoundaryStyle\" -> Automatic, \"DefaultChartBaseStyle\" -> RGBColor[0.987148, 0.8073604000000001, 0.49470040000000004], \"DefaultGraphicsInteraction\" -> {\"Version\" -> 1.2, \"TrackMousePosition\" -> {True, False}, \"Effects\" -> {\"Highlight\" -> {\"ratio\" -> 2}, \"HighlightPoint\" -> {\"ratio\" -> 2}, \"Droplines\" -> {\"freeformCursorMode\" -> True, \"placement\" -> {\"x\" -> \"All\", \"y\" -> \"None\"}}}}, \"DefaultPlotStyle\" -> Automatic, \"DomainPadding\" -> Scaled[0.02], \"RangePadding\" -> Scaled[0.05]}, PlotLabel -> StringForm[\"Level Spacing Distribution (W = `1`)\", 1000], PlotRange -> {{0, 21/50}, {All, All}}, PlotRangePadding -> {{Scaled[0.02], Scaled[0.02]}, {Scaled[0.02], Scaled[0.05]}}, Ticks -> {Automatic, Automatic}}]",
